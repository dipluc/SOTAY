<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_rounded_dialog_set_budget">

    <!-- Header Icon -->
    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_gauge"
        android:contentDescription="Gauge Icon"
        android:layout_marginBottom="16dp" />

    <!-- Dialog Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_budget"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="20dp" />

    <!-- Month / Year Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tháng / năm"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <!-- Month / Year Field -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/imgCalendarIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_calendar"
            android:contentDescription="Calendar"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/txtMonthYear"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@id/imgCalendarIcon"
            android:gravity="center_vertical"
            android:text="10-2026"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </RelativeLayout>

    <!-- Budget Limit Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hạn mức chi tiêu"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Budget Amount Input -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/txtCurrencyUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="VNĐ"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <EditText
            android:id="@+id/edtBudgetAmount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@id/txtCurrencyUnit"
            android:background="@android:color/transparent"
            android:hint="0"
            android:inputType="number"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />
    </RelativeLayout>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_primary"
        android:text="Lưu hạn mức"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/color_16_62_71" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rounded_btncancel"
        android:text="@string/cancel"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/primary_dark" />

</LinearLayout>
